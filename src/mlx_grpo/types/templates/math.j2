# Math rollout template — think → \boxed{answer}
# Variables: prompt, answer, batch.scaffold_thinking_ratio
# Callbacks: slice_answer, coin_flip, has_tag

# Curriculum scaffolding (decays over training)
@scaffold ratio=batch.scaffold_thinking_ratio mode=prefix tag=scaffold

# Phase 1: Thinking
@generate max_tokens=2048 stop=</think> temperature=0.7 tag=thinking as=thinking

# Recovery if thinking didn't terminate
@if condition=thinking.stop_reason=="max_tokens"
@inject text="</think>\n" masked=true
@endif

# Phase 2: Answer with \boxed{} format
@inject text="\n\\boxed{" masked=true tag=answer_prefix
@generate max_tokens=128 stop=} temperature=0.3 tag=answer as=answer

# Ensure closing brace
@inject text="}" masked=true
